AR_HOST=0.0.0.0
AR_PORT=8080
AR_THREADS=3
AR_STATIC_ROOT=WebApps/ARServer/www
# 默认异步写入项目根目录 logs/；设为 false 时仅输出到终端。
AR_LOG_ENABLED=true
# 单个日志文件达到该大小后滚动，单位 MB。
AR_LOG_ROLL_SIZE_MB=100
# 异步日志最长刷新间隔，单位秒。
AR_LOG_FLUSH_INTERVAL=3
# 启动时清理该天数之前的 ar_server 日志；设为 0 时不自动清理。
AR_LOG_RETENTION_DAYS=7
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ar_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=webserver
MYSQL_POOL_SIZE=8
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_POOL_SIZE=8
DB_WORKERS=4
CACHE_WORKERS=4
SESSION_TTL_SECONDS=1800
MAX_BODY_BYTES=1048576
